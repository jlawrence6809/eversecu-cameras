# Copy this file to .env, chmod it to 600, and fill in the password locally.
CAMERA_HOST=192.0.2.10
CAMERA_USERNAME=admin
CAMERA_PASSWORD=replace-me
CAMERA_NAME=yard

# Detector tuning. The initial COCO model calls likely coyotes "dog".
DETECTION_INTERVAL_SECONDS=1.0
DETECTION_CONFIDENCE=0.35
EVENT_COOLDOWN_SECONDS=30
EVENT_RETENTION_DAYS=14
EVENT_OUTPUT_DIR=events
